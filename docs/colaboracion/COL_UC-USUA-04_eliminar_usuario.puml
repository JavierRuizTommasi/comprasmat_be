@startuml ColaboracionSecuenceEliminarUsuario
hide footbox

actor "Usuario" as (1)
actor "Sistema" as (2)
actor "BaseDeDatos" as (3)

1 --> 2: Solicita \nadministrar \nusuarios
2 --> 3: Consulta base \nde datos \nde Usuarios
3 --> 2: Devuelve lista \nde usuarios
2 --> 1: Muestra la lista \nde los usuarios \nalmacenados
1 --> 2: Selecciona \neliminar \nun usuario
2 --> 1: Muestra los datos \ndel usuario solicitado
1 --> 2: Selecciona \nEliminar
2 --> 3: Actualiza estado \ndel Usuario a \nDe Baja
3 --> 2: Confirma resultado \nactualización del usuario
2 --> 1: Notifica resultado \nactualización del usuario

@enduml
